rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── Users Collection ────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── Agents Collection ───────────────────────────────────
    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── Orders Collection ───────────────────────────────────
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;

      match /statusHistory/{historyId} {
        allow read, write: if true;
      }
    }

    // ─── Zones & Area Mappings ───────────────────────────────
    match /zones/{zoneId} {
      allow read, write: if true;
    }
    match /zone_area_mappings/{mappingId} {
      allow read, write: if true;
    }

    // ─── Rate Cards & COD Configs ────────────────────────────
    match /rate_cards/{rateCardId} {
      allow read, write: if true;
    }
    match /cod_surcharge_configs/{configId} {
      allow read, write: if true;
    }

    // ─── Saved Addresses ─────────────────────────────────────
    match /saved_addresses/{addressId} {
      allow read, write: if true;
    }

    // ─── Wallet Transactions ─────────────────────────────────
    match /wallet_transactions/{txId} {
      allow read, write: if true;
    }

    // ─── Notifications ───────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ─── System Metadata & Initialization ────────────────────
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
