// PostgreSQL schema for production deployment (Render / Railway)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum AreaType {
  PINCODE
  LOCALITY
}

enum OrderType {
  B2B
  B2C
}

enum RateType {
  INTRA_ZONE
  INTER_ZONE
}

enum PaymentType {
  PREPAID
  COD
}

enum OrderStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
}

enum NotificationType {
  STATUS_CHANGE
  RESCHEDULE
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  password       String
  name           String
  phone          String?
  role           Role                 @default(CUSTOMER)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  agent          Agent?
  customerOrders Order[]              @relation("CustomerOrders")
  statusActions  OrderStatusHistory[] @relation("StatusActor")
  notifications  Notification[]

  @@map("users")
}

model Zone {
  id           String            @id @default(uuid())
  name         String            @unique
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  areaMappings ZoneAreaMapping[]
  agents       Agent[]
  pickupOrders Order[]           @relation("PickupZone")
  dropOrders   Order[]           @relation("DropZone")

  @@map("zones")
}

model ZoneAreaMapping {
  id             String   @id @default(uuid())
  zoneId         String
  areaIdentifier String
  areaType       AreaType @default(PINCODE)
  createdAt      DateTime @default(now())
  zone           Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([areaIdentifier, areaType])
  @@index([zoneId])
  @@map("zone_area_mappings")
}

model RateCard {
  id          String    @id @default(uuid())
  orderType   OrderType
  rateType    RateType
  baseCharge  Float
  perKgCharge Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orderType, rateType])
  @@map("rate_cards")
}

model CODSurchargeConfig {
  id              String    @id @default(uuid())
  orderType       OrderType @unique
  surchargeAmount Float
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("cod_surcharge_configs")
}

model Agent {
  id            String   @id @default(uuid())
  userId        String   @unique
  currentZoneId String?
  latitude      Float?
  longitude     Float?
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentZone   Zone?    @relation(fields: [currentZoneId], references: [id])
  orders        Order[]  @relation("AssignedAgent")

  @@index([isAvailable])
  @@index([currentZoneId])
  @@map("agents")
}

model Order {
  id                 String               @id @default(uuid())
  customerId         String
  pickupAddress      String
  pickupPincode      String
  dropAddress        String
  dropPincode        String
  pickupZoneId       String?
  dropZoneId         String?
  lengthCm           Float
  breadthCm          Float
  heightCm           Float
  actualWeightKg     Float
  volumetricWeightKg Float
  billableWeightKg   Float
  orderType          OrderType
  paymentType        PaymentType
  baseCharge         Float
  codSurcharge       Float                @default(0)
  totalCharge        Float
  status             OrderStatus          @default(PENDING)
  assignedAgentId    String?
  rescheduleDate     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  customer           User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  pickupZone         Zone?                @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropZone           Zone?                @relation("DropZone", fields: [dropZoneId], references: [id])
  assignedAgent      Agent?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  statusHistory      OrderStatusHistory[]
  notifications      Notification[]

  @@index([customerId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  timestamp DateTime    @default(now())
  actorId   String
  notes     String?
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User        @relation("StatusActor", fields: [actorId], references: [id])

  @@index([orderId])
  @@index([timestamp])
  @@map("order_status_history")
}

model Notification {
  id        String              @id @default(uuid())
  orderId   String
  userId    String
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  subject   String?
  body      String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@map("notifications")
}
