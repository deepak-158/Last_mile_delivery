# ─── Server ────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────
# Railway: Auto-provided as DATABASE_URL when you add a PostgreSQL add-on
# Local:   Use SQLite → file:./dev.db (swap schema with `npm run dev:local`)
DATABASE_URL="postgresql://user:password@localhost:5432/lastmile_delivery?schema=public"

# ─── JWT ───────────────────────────────────────────────
# Railway: Set a strong random secret in your service variables
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ─── Email (Gmail SMTP) ───────────────────────────────
# Optional — notifications will log to console if not set
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="LastMile Delivery <your-email@gmail.com>"

# ─── SMS (stub — swap provider later) ─────────────────
SMS_PROVIDER="console"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# ─── Frontend URL (for CORS) ──────────────────────────
# Railway: Set to your Vercel deployment URL
FRONTEND_URL="http://localhost:5173"
